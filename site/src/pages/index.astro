---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { postSlug } from '../lib/slug';
import { dateFromId, isoDate, listDate, type EntryDate } from '../lib/date';

const articles = await getCollection('articles', (e) => e.data.published);
const posts = await getCollection('posts');

type Item = {
  title: string;
  href: string;
  when: EntryDate | null;
  tags: string[];
  kind: 'article' | 'post';
};

const items: Item[] = [
  ...articles.map((e) => ({
    title: e.data.title,
    href: `/articles/${e.id}/`,
    when: e.data.published_at
      ? { date: new Date(e.data.published_at), hasDay: true }
      : dateFromId(e.id),
    tags: e.data.topics,
    kind: 'article' as const,
  })),
  ...posts.map((e) => ({
    title: e.data.title,
    href: `/posts/${postSlug(e.id)}/`,
    when: { date: e.data.date, hasDay: true },
    tags: e.data.tags,
    kind: 'post' as const,
  })),
].sort((a, b) => (b.when?.date.valueOf() ?? 0) - (a.when?.date.valueOf() ?? 0));
---

<Layout title="データの裏側をあるく" description="技術記事と雑記">
  <h1>記事一覧</h1>
  <p class="page-lead">技術記事と雑記。</p>

  <ul class="entry-list">
    {
      items.map((item) => (
        <li class="entry">
          <a class="entry-link" href={item.href}>
            {item.when ? (
              <time class="entry-date" datetime={isoDate(item.when)}>
                {listDate(item.when)}
              </time>
            ) : (
              <span class="entry-date" />
            )}
            <span class="entry-body">
              <span class="entry-title">{item.title}</span>
              {(item.kind === 'article' || item.tags.length > 0) && (
                <span class="entry-meta">
                  {item.kind === 'article' && <span class="entry-source">Zenn</span>}
                  {item.tags.map((tag) => (
                    <span class="entry-tag">{tag}</span>
                  ))}
                </span>
              )}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
