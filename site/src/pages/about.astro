<style>
  .about {
    margin-top: 26px;
  }
  .about h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 36px 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }
  .about p {
    margin: 0 0 12px;
  }
  .link-list,
  .history {
    margin: 0 0 8px;
    padding-left: 1.3em;
  }
  .link-list li,
  .history li {
    margin-bottom: 8px;
    line-height: 1.7;
  }
  .history {
    list-style: none;
    padding-left: 0;
  }
  .history li {
    padding: 5px 0;
    border-bottom: 1px solid var(--border);
