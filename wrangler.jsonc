{
  // Cloudflare Workers Builds はリポジトリルートで `npx wrangler deploy` を実行するため、
  // 設定はここに一本化する（site/ 側には置かない）。
  // build フックで site/ の Astro ビルドを走らせてから ./site/dist を配信する。
  "name": "koylog",
  "compatibility_date": "2026-08-01",
  "build": {
    "command": "npm ci && npm run build",
    "cwd": "site"
  },
  "assets": { "directory": "./site/dist" }
}
